ALB_ARN=<arn-of-the-alb>
ALB_DNS=<alb-dns-name>
ALB_SG_ID=<alb-security-group-id>
ALB_CANONICAL_HOSTED_ZONE_ID=<hosted-zone-id>
LISTENER_ARN=<arn-of-the-listener>
CLUSTER_NAME=<ecs-cluster-name>
REPOSITORY_NAME=<ecr-repository-name>
DOMAIN_NAME=<domain.example.com>
EFS_FILE_SYSTEM_ID=<efs-file-system-id>
EFS_SG_ID=<efs-security-group-id>

APP_ENV=<development|staging|production>
NODE_ENV=production

# Los siguientes valores solo se usan para setup-ssm — no se inyectan al contenedor directamente
DB_HOST=<db-host>
DB_USER=<db-user>
DB_NAME=<db-name>
DB_PORT=5432
DB_PASSWORD='<db-password>'  # usar comillas simples si la contraseña tiene caracteres especiales ($, *, etc.)
LABEL_STUDIO_USERNAME=<admin-email>
LABEL_STUDIO_PASSWORD='<admin-password>'
