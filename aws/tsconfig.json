{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "paths": {
      "#lib/*": ["lib/*"],
      "#bin/*": ["bin/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "cdk.out"]
}
